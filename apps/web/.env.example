NODE_ENV=development
# Local dev: http://localhost:4000
# Vercel sandbox/preview: set this in the Vercel dashboard → Settings → Environment Variables
# Production Vercel URL (frontend): https://vivah-australia-web.vercel.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Billing ──────────────────────────────────────────────────────────────────
# Get from Stripe Dashboard → Developers → API keys
# Use pk_test_ prefix for sandbox, pk_live_ for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
